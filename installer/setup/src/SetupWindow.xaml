<!--
  Loaded at runtime with XamlReader (csc can't compile XAML), so no x:Class and no event
  attributes: SetupWindow.cs finds the named elements and wires them up.
  Styles come from Styles.xaml; colours follow src/renderer/src/styles/global.css.
-->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        CornerRadius="14" BorderBrush="#1F2330" BorderThickness="1"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="#F4F6FF" TextOptions.TextFormattingMode="Display">
  <Border.Background>
    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1" RadiusY="0.8">
      <GradientStop Color="#123842" Offset="0" />
      <GradientStop Color="#0A0D15" Offset="0.62" />
      <GradientStop Color="#05060A" Offset="1" />
    </RadialGradientBrush>
  </Border.Background>


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent" Height="44">
      <TextBlock Text="VibeSync setup" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" />
      <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="Close" IsCancel="True">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1.4"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="36,0,36,30">

      <Grid x:Name="WelcomePage">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Image x:Name="Logo" Width="104" Height="104" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="VibeSync" Style="{StaticResource Title}" FontSize="30" Margin="0,16,0,0" />
          <TextBlock x:Name="VersionText" Style="{StaticResource Body}" Margin="0,4,0,0" />

          <StackPanel x:Name="OptionsPanel" Visibility="Collapsed" Margin="0,26,0,0">
            <TextBlock Text="Install folder" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FolderBox" Style="{StaticResource Field}" />
              <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </Grid>
            <CheckBox x:Name="ShortcutBox" Content="Create a desktop shortcut" IsChecked="True" Style="{StaticResource Check}" Margin="0,16,0,0" />
          </StackPanel>

          <TextBlock x:Name="WelcomeError" Foreground="#FF4D6D" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock x:Name="RunningNotice" Text="VibeSync is running. Setup will close it." Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,12" Visibility="Collapsed" />
          <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}" IsDefault="True" />
          <Button x:Name="OptionsButton" Content="Options" Style="{StaticResource LinkButton}" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>

      <Grid x:Name="ProgressPage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <Image x:Name="ProgressLogo" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <ScaleTransform x:Name="Pulse" />
            </Image.RenderTransform>
          </Image>
          <TextBlock x:Name="ProgressTitle" Text="Installing VibeSync" Style="{StaticResource Title}" FontSize="20" Margin="0,22,0,0" />
          <TextBlock x:Name="ProgressText" Text="Preparing…" Style="{StaticResource Body}" Margin="0,6,0,22" />
          <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="DonePage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Grid Width="72" Height="72">
            <Ellipse Fill="#0F2A22" Stroke="#2BFF88" StrokeThickness="2" />
            <Path Data="M22,37 L32,47 L51,27" Stroke="#2BFF88" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Grid>
          <TextBlock x:Name="DoneTitle" Text="VibeSync is installed" Style="{StaticResource Title}" FontSize="20" Margin="0,22,0,0" />
          <TextBlock x:Name="DoneText" Style="{StaticResource Body}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="LaunchButton" Content="Launch VibeSync" Style="{StaticResource PrimaryButton}" />
          <Button x:Name="DoneCloseButton" Content="Close" Style="{StaticResource LinkButton}" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>

      <Grid x:Name="ErrorPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Grid Width="72" Height="72">
            <Ellipse Fill="#2A0F17" Stroke="#FF4D6D" StrokeThickness="2" />
            <Path Data="M36,22 L36,40 M36,49 L36,50" Stroke="#FF4D6D" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Grid>
          <TextBlock Text="Setup couldn't finish" Style="{StaticResource Title}" FontSize="20" Margin="0,22,0,0" />
          <TextBlock x:Name="ErrorText" Style="{StaticResource Body}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource PrimaryButton}" />
          <Button x:Name="ErrorCloseButton" Content="Close" Style="{StaticResource LinkButton}" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>

    </Grid>
  </Grid>
</Border>
