{
  "name": "vibesync",
  "productName": "VibeSync",
  "version": "2.2.1",
  "description": "VibeSync - VibeDeck fork with Spotify, synchronized lyrics and album artwork colors",
  "main": "./out/main/index.js",
  "author": "Shady",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/shadythewolf/VibeSync",
  "desktopName": "vibesync.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:helper": "vitest run tests/integration",
    "helper:build": "powershell -NoProfile -ExecutionPolicy Bypass -File helper/build.ps1",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run icons && npm run helper:build && electron-vite build && electron-builder --win --publish never --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never --config electron-builder.yml",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never --config electron-builder.yml",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "qa:fps": "node scripts/qa/measure-fps.mjs",
    "qa:smoothness": "node scripts/qa/profile-visualizer.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "contributors": [
    "Amara Dhanush Kumar (original VibeDeck author, https://github.com/dhanush-the-versatile/VibeDeck)"
  ],
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
